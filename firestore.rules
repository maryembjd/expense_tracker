rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return request.auth.uid == userId;
    }

    function isValidExpense() {
      let data = request.resource.data;
      return data.keys().hasAll(['userId', 'amount', 'currency', 'category', 'description', 'date', 'createdAt'])
        && data.amount is number
        && data.amount > 0
        && data.amount < 1000000000
        && data.currency is string
        && data.currency.size() == 3
        && data.description is string
        && data.description.size() > 0
        && data.description.size() <= 200;
    }

    function isValidBudget() {
      let data = request.resource.data;
      return data.keys().hasAll(['userId', 'totalBudget', 'currency', 'month', 'year'])
        && data.totalBudget is number
        && data.totalBudget >= 0
        && data.month is int
        && data.month >= 1
        && data.month <= 12
        && data.year is int
        && data.year >= 2020;
    }

    // Users collection
    match /users/{userId} {
      allow read: if isAuthenticated() && isOwner(userId);
      allow create: if isAuthenticated() && isOwner(userId);
      allow update: if isAuthenticated() && isOwner(userId)
        && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['uid', 'email', 'createdAt']);
      allow delete: if isAuthenticated() && isOwner(userId);
    }

    // Expenses collection
    match /expenses/{expenseId} {
      allow read: if isAuthenticated() && resource.data.userId == request.auth.uid;
      allow create: if isAuthenticated()
        && request.resource.data.userId == request.auth.uid
        && isValidExpense();
      allow update: if isAuthenticated()
        && resource.data.userId == request.auth.uid
        && request.resource.data.userId == request.auth.uid
        && isValidExpense();
      allow delete: if isAuthenticated() && resource.data.userId == request.auth.uid;
    }

    // Budgets collection
    match /budgets/{budgetId} {
      allow read: if isAuthenticated() && resource.data.userId == request.auth.uid;
      allow create: if isAuthenticated()
        && request.resource.data.userId == request.auth.uid
        && isValidBudget();
      allow update: if isAuthenticated()
        && resource.data.userId == request.auth.uid
        && request.resource.data.userId == request.auth.uid;
      allow delete: if isAuthenticated() && resource.data.userId == request.auth.uid;
    }
  }
}
